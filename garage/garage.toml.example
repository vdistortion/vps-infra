# Garage single-node configuration.
# Copy to garage.toml and replace the placeholders with real secrets:
#   rpc_secret:    openssl rand -hex 32
#   admin_token:   openssl rand -base64 32
#   metrics_token: openssl rand -base64 32
#
# ! Do NOT commit garage.toml with real secrets — add it to .gitignore.
# See https://garagehq.deuxfleurs.fr/documentation/reference-manual/configuration/

metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "REPLACE_WITH_rpc_secret"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"

[s3_web]
bind_addr = "[::]:3902"
root_domain = ".web.garage.localhost"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "REPLACE_WITH_admin_token"
metrics_token = "REPLACE_WITH_metrics_token"
